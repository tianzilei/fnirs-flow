{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "fnirs-flow ReadinessResult",
  "type": "object",
  "required": ["status"],
  "properties": {
    "status": { "type": "string", "enum": ["Ready", "Needs Attention", "Blocked"] },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "status"],
        "properties": {
          "name": { "type": "string" },
          "status": { "type": "string", "enum": ["pass", "warn", "fail", "skip"] },
          "message": { "type": "string" }
        }
      }
    }
  }
}
